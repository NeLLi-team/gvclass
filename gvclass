#!/usr/bin/env python3
"""GVClass launcher: runs the repository code natively, or the Apptainer image.

The container mode lives only in this script, so the script also works when it is
downloaded alone. In container mode it reads the options that it needs for the
mounts and gives every other option to GVClass in the container unchanged.
"""

from __future__ import annotations

import argparse
import hashlib
import os
import re
import shutil
import subprocess
import sys
import tempfile
from collections.abc import Sequence
from pathlib import Path
from urllib.parse import urlparse

DEFAULT_IMAGE = "oras://ghcr.io/nelli-team/gvclass:2.1.1"
IMAGE_CACHE_DIR = Path.home() / ".cache" / "gvclass" / "images"
DEFAULT_RESOURCE_CACHE_DIR = (
    Path.home() / ".cache" / "gvclass" / "resource-cache" / "v2.1.0"
)
CONTAINER_RESOURCE_CACHE_DIR = "/resource-cache"
CONTAINER_DATABASE_DIR = "/opt/gvclass/resources"
#: Set before the launcher runs itself again, so that it does so only once.
RUNTIME_SELECTED_ENV = "GVCLASS_RUNTIME_SELECTED"

#: Options with a value that the container run reads for its mounts.
OWN_VALUE_OPTIONS = ("-o", "--output-dir", "--image", "--resource-cache-dir")
#: Options with a value that name host files, which a classification in the
#: container cannot use: it has the database of the image and no configuration.
NATIVE_ONLY_VALUE_OPTIONS = ("-c", "--config", "-d", "--database")
#: Options with a value that go to GVClass in the container as typed. The launcher
#: must know that they take a value, or the value could pass for the input path. A
#: test keeps this list equal to the options of ``src/bin/gvclass_cli.py``.
FORWARDED_VALUE_OPTIONS = (
    "-t",
    "--threads",
    "-j",
    "--max-workers",
    "--threads-per-worker",
    "--tree-method",
    "--iqtree-mode",
    "--completeness-mode",
    "--min-length",
    "--contigs-min-length",
    "--species-tree-trim",
)
CONTIGS_FILE_SUFFIXES = {".fna", ".fa", ".fasta", ".fas"}


def is_gvclass_repo(path: Path) -> bool:
    """Return whether ``path`` holds the GVClass sources, not just any ``src``."""
    return (path / "src" / "bin" / "gvclass_cli.py").is_file()


def resolve_repo_dir(script_path: Path) -> Path:
    """Resolve the GVClass repo directory for a checkout or installed script."""
    candidate = script_path.parent
    if is_gvclass_repo(candidate):
        return candidate

    env_path = os.environ.get("GVCLASS_REPO")
    if env_path:
        env_repo = Path(env_path).expanduser().resolve()
        if is_gvclass_repo(env_repo):
            return env_repo

    repo_path_file = Path.home() / ".config" / "gvclass" / "repo_path"
    if repo_path_file.exists():
        repo_path = repo_path_file.read_text().strip()
        if repo_path:
            file_repo = Path(repo_path).expanduser().resolve()
            if is_gvclass_repo(file_repo):
                return file_repo

    cwd = Path.cwd().resolve()
    for parent in [cwd] + list(cwd.parents):
        if is_gvclass_repo(parent) and (parent / "gvclass").exists():
            return parent

    return candidate


def _should_use_apptainer(argv: Sequence[str], *, has_local_repo: bool) -> bool:
    """Tell whether to run in the image: no checkout, or a container flag."""
    if not has_local_repo:
        return True
    return any(
        token in {"--apptainer", "--image"} or token.startswith("--image=")
        for token in argv
    )


def runtime_argv(
    repo_dir: Path,
    launcher: Path,
    argv: Sequence[str],
    *,
    running_python: Path,
    pixi: str | None,
    selected: bool,
) -> list[str] | None:
    """Return the command that runs the launcher again in the runtime of the checkout.

    The runtime is the Python of ``<repo>/.pixi/envs/default``. Without that
    environment, ``pixi run`` makes it. The result is ``None`` when the launcher
    already runs in the right Python, when no runtime is available, or when it has
    already chosen one (``selected``), which keeps it from running itself in a loop.
    """
    if selected:
        return None
    env_python = repo_dir / ".pixi" / "envs" / "default" / "bin" / "python"
    if env_python.exists():
        if env_python.resolve() == running_python.resolve():
            return None
        return [str(env_python), str(launcher), *argv]
    if pixi is not None:
        manifest = repo_dir / "pixi.toml"
        return [
            pixi,
            "run",
            "--manifest-path",
            str(manifest),
            "python",
            str(launcher),
            *argv,
        ]
    return None


def default_output_dir(input_path: Path) -> Path:
    """Return ``<name>_results`` in the working directory.

    ``<name>`` is the name of the input directory, or the file name without its
    suffix for a single file. The native command line gives the same answer.
    """
    resolved = input_path.resolve()
    name = resolved.stem if resolved.is_file() else resolved.name
    return Path.cwd() / f"{name}_results"


def is_remote_image_uri(image: str) -> bool:
    """Tell whether ``image`` is an address to pull, not a local file."""
    return image.startswith(("oras://", "docker://", "library://", "https://"))


def cache_filename_for_image(image: str) -> str:
    """Return the name of the cache file for a remote image address."""
    if image.startswith("https://"):
        slug = Path(urlparse(image).path).name
    else:
        slug = image.split("://", 1)[1]
    # Two addresses can share a readable name: one basename on two hosts, one path under
    # oras:// and docker://, or names that differ only in punctuation. The digest of the
    # whole address keeps their caches apart.
    prefix = hashlib.sha256(image.encode("utf-8")).hexdigest()[:12] + "_"
    slug = re.sub(r"[^A-Za-z0-9._-]+", "_", slug).strip("_")
    if not slug:
        slug = "gvclass_image"
    if not slug.endswith(".sif"):
        slug = f"{slug}.sif"
    return prefix + slug


def validate_cached_image(path: Path) -> None:
    """Reject non-SIF cache entries and objects beyond the downloaded file."""
    if path.is_symlink() or not path.is_file():
        raise SystemExit(f"Invalid Apptainer image: {path}")
    try:
        inspected = subprocess.run(
            ["apptainer", "sif", "list", str(path)],
            capture_output=True,
            text=True,
            check=False,
            timeout=30,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise SystemExit(
            f"Could not inspect Apptainer image: {path}: {error}"
        ) from error
    objects = re.findall(
        r"^\s*\d+\s*\|[^|]*\|[^|]*\|\s*(\d+)-(\d+)\s*\|([^\n]+)$",
        inspected.stdout,
        re.MULTILINE,
    )
    size = path.stat().st_size
    if (
        inspected.returncode != 0
        or not objects
        or any(not 0 <= int(start) <= int(end) <= size for start, end, _ in objects)
        or not any(
            "FS (" in kind and "/*System/" in kind and int(start) < int(end)
            for start, end, kind in objects
        )
    ):
        raise SystemExit(f"Invalid Apptainer image: {path}")


def ensure_local_image(image: str) -> str:
    """Return the path of a local image, pulling a remote address into the cache."""
    if image.startswith("http://"):
        raise SystemExit(f"Use an https:// address, not a plain http:// one: {image}")
    if not is_remote_image_uri(image):
        return image

    IMAGE_CACHE_DIR.mkdir(parents=True, exist_ok=True)
    local_image = IMAGE_CACHE_DIR / cache_filename_for_image(image)
    if local_image.exists() or local_image.is_symlink():
        validate_cached_image(local_image)
        return str(local_image)

    with tempfile.TemporaryDirectory(prefix=".pull-", dir=IMAGE_CACHE_DIR) as staging:
        staged_image = Path(staging) / "image.sif"
        pull_cmd = ["apptainer", "pull", "-F", str(staged_image), image]
        if subprocess.call(pull_cmd) != 0:
            raise SystemExit(f"Failed to pull Apptainer image: {image}")
        validate_cached_image(staged_image)
        try:
            # A hard link installs atomically without replacing a concurrent entry.
            local_image.hardlink_to(staged_image)
        except FileExistsError:
            validate_cached_image(local_image)
        except OSError as error:
            raise SystemExit(
                f"Could not install cached Apptainer image: {local_image}: {error}"
            ) from error
    return str(local_image)


def database_root(database: str | None, resource_cache: Path) -> Path:
    """Return the host folder that holds the screen add-on.

    It is the one that ``gvclass screen`` uses: the database named by ``-d``, else
    ``GVCLASS_DB``, else the resource cache.
    """
    chosen = database or os.environ.get("GVCLASS_DB", "").strip() or resource_cache
    return Path(chosen).expanduser().resolve()


def addon_mount(root: Path) -> list[str]:
    """Return the ``-B`` option that mounts the add-on of ``root``, or nothing.

    The add-on is mounted read-only into the database of the image, where the screen
    step looks for it. The base database of the image stays in place, whatever else
    ``root`` holds. Without an add-on, ``screen_status`` reads ``not_installed``.
    """
    addon = root / "contig_screen"
    if not (addon / "manifest.json").is_file():
        return []
    return ["-B", f"{addon}:{CONTAINER_DATABASE_DIR}/contig_screen:ro"]


def container_command(
    *,
    image: str,
    source: Path,
    output: Path,
    resource_cache: Path,
    forwarded: Sequence[str],
) -> list[str]:
    """Return the ``apptainer run`` command of a classification."""
    if source.is_file():
        bind_source, query_in_container = source.parent, f"/input/{source.name}"
    else:
        bind_source, query_in_container = source, "/input"
    return [
        "apptainer",
        "run",
        "-B",
        f"{bind_source}:/input:ro",
        "-B",
        f"{output}:/output",
        "-B",
        f"{resource_cache}:{CONTAINER_RESOURCE_CACHE_DIR}",
        *addon_mount(database_root(None, resource_cache)),
        "--env",
        f"GVCLASS_RESOURCE_CACHE={CONTAINER_RESOURCE_CACHE_DIR}",
        # Apptainer passes the host environment; a host GVCLASS_DB would otherwise
        # replace the database of the image, which holds the mounted add-on.
        "--env",
        f"GVCLASS_DB={CONTAINER_DATABASE_DIR}",
        image,
        query_in_container,
        "-o",
        "/output",
        *forwarded,
    ]


class _Forward(argparse.Action):
    """Remember an option as typed, to give it to GVClass in the container."""

    def __call__(
        self,
        _parser: argparse.ArgumentParser,
        namespace: argparse.Namespace,
        values: Sequence[str],
        option_string: str | None = None,
    ) -> None:
        namespace.forwarded.extend([option_string, *values])


def _build_container_parser(*, add_help: bool = True) -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="gvclass",
        description="Run GVClass in an Apptainer container.",
        epilog=(
            "Every other option goes to GVClass in the container as typed; "
            "see docs/reference/cli.md."
        ),
        add_help=add_help,
    )
    parser.add_argument(
        "query_path",
        nargs="?",
        help="Input directory of FASTA files, or one FNA file with --contigs",
    )
    parser.add_argument(
        "-o",
        "--output-dir",
        help="Output directory (default: <name>_results in the current directory)",
    )
    parser.add_argument(
        "-C",
        "--contigs",
        action="store_true",
        help="Per-contig mode: split input FNA(s) and classify each contig separately",
    )
    parser.add_argument(
        "--apptainer", action="store_true", help="Run GVClass via Apptainer container"
    )
    parser.add_argument(
        "--image",
        default=DEFAULT_IMAGE,
        help=(
            "Apptainer image address or path. oras://, docker://, library:// and "
            "https:// addresses are pulled and cached locally; a library:// address "
            "needs a library endpoint that Apptainer knows (default: %(default)s)"
        ),
    )
    parser.add_argument(
        "--resource-cache-dir",
        default=str(DEFAULT_RESOURCE_CACHE_DIR),
        help=(
            "Host directory for Parquet materialization cache (default: %(default)s)"
        ),
    )
    parser.add_argument(
        "--version", action="store_true", help="Show the default image of the launcher"
    )
    for option in NATIVE_ONLY_VALUE_OPTIONS:
        parser.add_argument(option, dest="native_only", help=argparse.SUPPRESS)
    for option in FORWARDED_VALUE_OPTIONS:
        parser.add_argument(
            option,
            action=_Forward,
            nargs=1,
            dest="forward_unused",
            help=argparse.SUPPRESS,
        )
    return parser


def _parse_container_args(
    parser: argparse.ArgumentParser, argv: Sequence[str]
) -> tuple[argparse.Namespace, list[str]]:
    """Parse the options of the launcher; return them with the ones for the image."""
    return parser.parse_known_args(argv, argparse.Namespace(forwarded=[]))


def container_main(argv: Sequence[str]) -> int:
    """Run GVClass, or its ``screen`` command, in the Apptainer image."""
    given = list(argv)
    probe, _ = _parse_container_args(_build_container_parser(add_help=False), given)
    if probe.query_path == "screen":
        return _screen_main(given)
    parser = _build_container_parser()
    args, extras = _parse_container_args(parser, given)
    if args.version:
        print(f"GVClass Apptainer launcher (default image: {DEFAULT_IMAGE})")
        return 0
    if args.query_path is None:
        if given:
            parser.error("the query path is required")
        parser.print_help()
        return 0
    if args.native_only:
        parser.error(
            "--config and --database apply to native runs only; "
            "the container uses the database of the image"
        )
    source = Path(args.query_path).resolve()
    if not source.exists():
        parser.error(f"Input path not found: {source}")
    if source.is_file() and not args.contigs:
        parser.error(f"Input is a file: {source}. Use --contigs for per-contig mode.")
    if source.is_file() and source.suffix.lower() not in CONTIGS_FILE_SUFFIXES:
        parser.error(
            "--contigs requires an FNA/FA/FASTA/FAS file when input is a file."
        )

    output = (
        Path(args.output_dir) if args.output_dir else default_output_dir(source)
    ).resolve()
    output.mkdir(parents=True, exist_ok=True)
    resource_cache = Path(args.resource_cache_dir).expanduser().resolve()
    resource_cache.mkdir(parents=True, exist_ok=True)
    command = container_command(
        image=ensure_local_image(args.image),
        source=source,
        output=output,
        resource_cache=resource_cache,
        forwarded=[*(["--contigs"] if args.contigs else []), *args.forwarded, *extras],
    )
    return subprocess.call(command)


def _build_screen_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Run contig screens via Apptainer")
    parser.add_argument("command", choices=["screen"], help="Run contig screens")
    parser.add_argument("input", nargs="?", type=Path, help="FASTA file or folder")
    parser.add_argument(
        "--install", action="store_true", help="Install screen resources"
    )
    parser.add_argument("-o", "--output-dir", type=Path, help="Default: <input>_screen")
    parser.add_argument("-d", "--database", help="Host database (default: GVCLASS_DB)")
    parser.add_argument(
        "-t", "--threads", type=int, help="Threads (default: those of GVClass)"
    )
    parser.add_argument("--apptainer", action="store_true", help="Use Apptainer")
    parser.add_argument(
        "--image", default=DEFAULT_IMAGE, help="Image URI or local path"
    )
    parser.add_argument(
        "--resource-cache-dir",
        type=Path,
        default=DEFAULT_RESOURCE_CACHE_DIR,
        help="Host cache for the optional screen resources",
    )
    return parser


def _screen_main(argv: Sequence[str]) -> int:
    parser = _build_screen_parser()
    args = parser.parse_intermixed_args(argv)
    if not args.install and args.input is None:
        parser.error("an input bin or folder is needed (or --install)")
    root = database_root(args.database, args.resource_cache_dir)
    if args.install:
        root.mkdir(parents=True, exist_ok=True)
        return subprocess.call(
            [
                "apptainer",
                "run",
                "-B",
                f"{root}:/screen-resources",
                ensure_local_image(args.image),
                "screen",
                "--install",
                "-d",
                "/screen-resources",
            ]
        )
    mount = addon_mount(root)
    if not mount:
        raise SystemExit(
            f"No contig-screen resources in {root}; run: gvclass screen --install"
        )
    source = args.input.expanduser().resolve()
    if not source.exists():
        parser.error(f"Input path not found: {source}")
    output = args.output_dir or source.with_name(source.name + "_screen")
    output = output.expanduser().resolve()
    output.mkdir(parents=True, exist_ok=True)
    bind_source = source.parent if source.is_file() else source
    container_input = f"/input/{source.name}" if source.is_file() else "/input"
    command = [
        "apptainer",
        "run",
        *mount,
        "-B",
        f"{bind_source}:/input:ro",
        "-B",
        f"{output}:/output",
        ensure_local_image(args.image),
        "screen",
        container_input,
        "-o",
        "/output",
        "-d",
        CONTAINER_DATABASE_DIR,
    ]
    if args.threads is not None:
        command.extend(["-t", str(args.threads)])
    return subprocess.call(command)


def main(argv: Sequence[str] | None = None) -> int:
    """Run in the Apptainer image, or natively in the runtime of the checkout."""
    given = list(sys.argv[1:] if argv is None else argv)
    script_path = Path(__file__).resolve()
    repo_dir = resolve_repo_dir(script_path)

    if _should_use_apptainer(given, has_local_repo=is_gvclass_repo(repo_dir)):
        return container_main(given)

    again = runtime_argv(
        repo_dir,
        script_path,
        given,
        running_python=Path(sys.executable),
        pixi=shutil.which("pixi"),
        selected=os.environ.get(RUNTIME_SELECTED_ENV) == "1",
    )
    if again is not None:
        os.environ[RUNTIME_SELECTED_ENV] = "1"
        os.execvp(again[0], again)

    if str(repo_dir) not in sys.path:
        sys.path.insert(0, str(repo_dir))
    os.environ.setdefault("GVCLASS_REPO", str(repo_dir))

    from src.bin.gvclass_cli import (  # noqa: PLC0415  # needs the runtime chosen above
        main as cli_main,
    )

    return cli_main(given, repo_dir=repo_dir)


if __name__ == "__main__":
    raise SystemExit(main())
